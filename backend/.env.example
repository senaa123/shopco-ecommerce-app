# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:1234@localhost:5432/shopco?schema=public"

# Secret used to sign JWT access tokens
JWT_SECRET="change-me-in-production"

# Port the NestJS server listens on
PORT=4000

# Origin allowed by CORS (the Next.js frontend)
FRONTEND_URL=http://localhost:3000

# Bootstrap admin account, created/updated by `npm run seed`.
# The seed script reads these from the environment and never hard-codes them.
ADMIN_EMAIL=admin@shopco.dev
ADMIN_PASSWORD=change-me-strong-password
